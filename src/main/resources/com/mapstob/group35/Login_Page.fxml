<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="18" style="-fx-background-color: #05001A;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mapstob.group35.LoginController">

    <!-- TOP BAR -->
    <BorderPane style="-fx-background-color: #062E50;">
        <left>
            <Button fx:id="backButton" onAction="#handleExit" style="-fx-background-color: #7D8570; -fx-text-fill: #FBFAF3;" text="EXIT" />
        </left>
        <center>
            <Label style="-fx-text-fill: #FBFAF3; -fx-font-size: 50px; -fx-font-weight: bold;" text="LOGIN" />
        </center>
        <padding>
            <Insets bottom="15" left="20" right="20" top="15" />
        </padding>
    </BorderPane>

    <!-- MAIN CONTENT -->
    <VBox alignment="CENTER" spacing="18" style="-fx-background-color: #05001A;" VBox.vgrow="ALWAYS">

        <padding>
            <Insets bottom="40" left="60" right="60" top="40" />
        </padding>

        <Label style="-fx-text-fill: #FBFAF3; -fx-font-weight: bold;" text="USERNAME" />

        <TextField fx:id="usernameField" prefHeight="19.0" prefWidth="403.0" promptText="Username" style="-fx-background-color: #FBFAF3; -fx-background-radius: 10;" />

        <Label style="-fx-text-fill: #FBFAF3; -fx-font-weight: bold;" text="PASSWORD" />

        <PasswordField fx:id="passwordField" prefWidth="200" promptText="Password" style="-fx-background-color: #FBFAF3; -fx-background-radius: 10;" />

        <HBox alignment="CENTER" spacing="15">

            <Button onAction="#handleLogin" prefWidth="150" style="-fx-background-color: #062E50; -fx-text-fill: #FBFAF3; -fx-background-radius: 8;" text="LOGIN" />

            <Button onAction="#handleRegister" prefWidth="150" style="-fx-background-color: #062E50; -fx-text-fill: #FBFAF3; -fx-background-radius: 8;" text="REGISTER" />

            <VBox alignment="CENTER_LEFT" spacing="2">
            <CheckBox fx:id="newParentBox" mnemonicParsing="false" style="-fx-text-fill: #FBFAF3; -fx-font-weight: bold;" text="New Parent Account" />
            </VBox>

        </HBox>
    </VBox>

</VBox>
