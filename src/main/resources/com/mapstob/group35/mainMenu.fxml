<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #05001A;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mapstob.group35.mainController">

   <children>
      <Text fill="WHITE" layoutX="30.0" layoutY="67.0" strokeType="OUTSIDE" strokeWidth="0.0" text="BOTSPAM">
         <font>
            <Font name="Consolas Bold" size="64.0" />
         </font>
      </Text>
      <VBox layoutX="24.0" layoutY="90.0" prefHeight="287.0" prefWidth="261.0">
         <children>
            <Button fx:id="newGame" mnemonicParsing="false" onAction="#StartGame" prefHeight="51.0" prefWidth="292.0" style="-fx-background-color: #062E50;" text="New Run" textFill="WHITE">
               <font>
                  <Font name="Consolas Bold" size="24.0" />
               </font>
            </Button>
            <Pane prefHeight="6.0" prefWidth="240.0" />
            <Button fx:id="tutorial" mnemonicParsing="false" onAction="#goToTutorial" prefHeight="51.0" prefWidth="445.0" style="-fx-background-color: #062E50;" text="Tutorial" textFill="WHITE">
               <font>
                  <Font name="Consolas Bold" size="24.0" />
               </font>
            </Button>
            <Pane prefHeight="6.0" prefWidth="240.0" />
            <Button fx:id="statsButton" mnemonicParsing="false" onAction="#goToStats" prefHeight="51.0" prefWidth="411.0" style="-fx-background-color: #062E50;" text="Stats" textFill="WHITE">
