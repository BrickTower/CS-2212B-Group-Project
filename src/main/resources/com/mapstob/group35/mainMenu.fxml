               <font>
                  <Font name="Consolas Bold" size="24.0" />
               </font>
            </Button>
            <Pane prefHeight="6.0" prefWidth="240.0" />
            <Button fx:id="parentalButton" layoutX="10.0" layoutY="164.0" mnemonicParsing="false" onAction="#goToParentalControls" prefHeight="51.0" prefWidth="329.0" style="-fx-background-color: #7c7c7c;" text="Parental Controls" textFill="WHITE" wrapText="true">
               <font>
                  <Font name="Consolas Bold" size="24.0" />
               </font>
            </Button>
         </children>
      </VBox>
      <Pane layoutX="314.0" layoutY="29.0" prefHeight="348.0" prefWidth="266.0" style="-fx-background-color: #062E50;">
         <children>
            <ScrollPane hbarPolicy="NEVER" hmax="0.0" layoutX="18.0" layoutY="50.0" prefHeight="282.0" prefWidth="238.0" style="-fx-background-color: #062E50;">
              <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="282.0" prefWidth="237.0" style="-fx-background-color: #062E50;">
                     <children>
                        <VBox fx:id="leaderboardBox" prefHeight="394.0" prefWidth="238.0">
                           <children>
                              <Text fill="WHITE" text="    NAME                          WAVE">
                                 <font><Font size="16.0" /></font>
                              </Text>
                              <Pane prefHeight="6.0" prefWidth="238.0" />
                              <!-- rows will be added here dynamically -->
                           </children>
                        </VBox>

                     </children>
                  </AnchorPane>
              </content>
            </ScrollPane>
            <Text fill="WHITE" layoutX="49.0" layoutY="29.0" strokeType="OUTSIDE" strokeWidth="0.0" text="LEADERBOARDS">
               <font>
                  <Font name="Consolas Bold" size="24.0" />
               </font>
            </Text>
         </children>
      </Pane>
   </children>
</AnchorPane>
